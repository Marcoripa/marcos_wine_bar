rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public creation of guestlist entries and consultations with basic validation
    match /wine_bar_guestlist/{document} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() > 3;
      allow read, update, delete: if false; // Only admin console can read/manage
    }

    match /sommelier_consultations/{document} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.venueName is string;
      allow read, update, delete: if false; // Only admin console can read/manage
    }

    match /private_event_enquiries/{document} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.source == "private-tastings-wizard";
      allow read, update, delete: if false; // Only admin console can read/manage
    }
  }
}
